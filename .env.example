# EDUQUEST AI CONFIGURATION
# Layer A MVP runs locally with zero external API keys.
AI_PROVIDER_MODE="rule_based"
OCR_ENABLED="false"
OCR_MAX_PAGES="10"
MAX_UPLOAD_MB="20"
LOCAL_STORAGE_DIR="./.local_storage"
SQLITE_DB_PATH="./eduquest.db"
JWT_SECRET="dev-only-change-in-production"

# Layer B Future Production Integrations (Optional, leave unset for Layer A MVP)
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL="gemini-4-hydrogen"
# GEMINI_FAST_MODEL="gemini-3.1-flash-lite"
# GEMINI_EMBEDDING_MODEL="gemini-embedding-2"
# SUPABASE_URL=""
# SUPABASE_SECRET_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
